# =============================================================================
# GOLD AI TRADING INTELLIGENCE PLATFORM — Environment Template
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=goldai
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=goldai
POSTGRES_HOST_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_HOST_PORT=6379

# ── Security (REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))") ──
SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_HEX_STRING

# ── Admin seed account (created on first startup) ────────────────────────────
ADMIN_EMAIL=admin@gold.ai
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ── JWT ───────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── ML ────────────────────────────────────────────────────────────────────────
ML_MODEL_DIR=/app/models

# ── CORS (comma-separated allowed origins) ───────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# ── External APIs ─────────────────────────────────────────────────────────────
# Twelvedata: https://twelvedata.com → Account → API Keys
TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# Telegram: https://t.me/BotFather → /newbot → copy the token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your personal Telegram chat ID (send /start to @userinfobot to find it)
TELEGRAM_CHAT_ID=

# ── Observability ─────────────────────────────────────────────────────────────
# Sentry: https://sentry.io → Create Project → DSN
SENTRY_DSN=

# ── Signal Engine Thresholds ──────────────────────────────────────────────────
SIGNAL_BUY_THRESHOLD=62
SIGNAL_SELL_THRESHOLD=38
SIGNAL_MIN_CONFIDENCE=65
# Signal engine: v2 (backend/strategy, default) | legacy (old weighted score)
SIGNAL_ENGINE=v2

# ── v2 strategy / risk parameters (all optional; defaults in backend/strategy/config.py) ──
# Broker-specific — CHECK against your broker's XAUUSD symbol specification:
# GOLDAI_SPREAD=0.30              # typical spread, USD/oz (used when no live quote)
# GOLDAI_SLIPPAGE=0.10            # per fill, USD/oz
# GOLDAI_COMMISSION_PER_LOT=0     # round-turn, account currency
# GOLDAI_CONTRACT_SIZE=100        # oz per 1.0 lot
# GOLDAI_LOT_STEP=0.01
# GOLDAI_MIN_LOT=0.01
# Conservative starting risk profile (suggestion, not enforced):
# GOLDAI_RISK_PCT=0.5             # % of balance per trade
# GOLDAI_MAX_SPREAD=0.60
# GOLDAI_MIN_RR=1.5               # after costs
# Strategy (changing these invalidates the published backtest):
# GOLDAI_PRIMARY_TF=240
# GOLDAI_CONTEXT_TF=1440
# GOLDAI_TARGET_RR=2.5
# Audit log (one JSON line per decision); default: $ML_MODEL_DIR/signal_audit.jsonl
# SIGNAL_AUDIT_LOG=/app/ml_models/signal_audit.jsonl

# ── Docker port overrides (for local development) ────────────────────────────
WEB_HOST_PORT=8001

# ── Internal service URL (used by Telegram bot inside Docker) ────────────────
INTERNAL_BASE_URL=http://backend:8001

# ── MT5 (optional — for live trading) ────────────────────────────────────────
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ── Data providers (optional additional providers) ───────────────────────────
# POLYGON_API_KEY=your_polygon_api_key
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# ── Paper trading / autonomous cycle (virtual money only; live trading is blocked in code) ──
TRADING_MODE=paper                # signal_only | paper   (anything else falls back to signal_only)
PAPER_TRADING_ENABLED=true
PAPER_START_BALANCE=10000
# PAPER_MAX_OPEN=1
# PAPER_DAILY_LOSS_PCT=2
# PAPER_MAX_DD_PCT=10
SIGNAL_CYCLE_ENABLED=true         # hourly v2 decision at :03
SIGNAL_CYCLE_ALERTS=false         # true = automatic cycle also sends Telegram alerts
CANDLE_REFRESH_MINUTES=15         # Twelvedata free tier ≈ 800 requests/day
# GOLDAI_SWAP_LONG=0              # USD/oz per night (set from your broker; usually negative)
# GOLDAI_SWAP_SHORT=0
# STRATEGY_REGISTRY_DIR=/app/ml_models/strategy_registry
